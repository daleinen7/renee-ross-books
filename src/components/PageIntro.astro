---
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---

<div class="intro">
  <p class="label">{label}</p>
  <h1>{title}</h1>
</div>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .label {
    margin: 0;
  }
  h1 {
    font-size: var(--step-3);
  }
</style>
