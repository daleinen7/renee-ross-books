---
import { Image } from 'astro:assets';
import manor from '../assets/manor.jpg';
import Nav from './Nav.astro';
import { SITE } from '../lib/site.ts';

interface Props {
  tagline: string;
}
const { tagline } = Astro.props;
---

<header class="hero">
  <div class="bar">
    <Nav />
  </div>
  <div class="title">
    <h1>{SITE.name}</h1>
    <p class="tagline">{tagline}</p>
  </div>
  <div class="scene">
    <Image
      src={manor}
      alt=""
      widths={[640, 1024, 1478, 1983]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="art"
    />
  </div>
</header>

<style>
  .scene {
    position: relative;
    overflow: clip;
  }
  .scene::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 25%;
    background: linear-gradient(to bottom, transparent, var(--color-ground));
  }
  .art {
    width: 100%;
  }
  /* Too wide to read at phone width: keep the full height and crop from the
     right, which keeps the figure and the manor in frame. */
  @media not (min-width: 48rem) {
    .art {
      aspect-ratio: 3 / 2;
      object-fit: cover;
      object-position: left center;
    }
  }
  .bar {
    display: flex;
    justify-content: flex-end;
    max-width: var(--content-width);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-3);
  }
  .title {
    max-width: var(--content-width);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3) var(--space-4);
    animation: rise var(--duration-slow) ease-out both;
  }
  h1 {
    font-family: var(--font-script);
    font-weight: 700;
    font-size: var(--step-5);
    color: var(--color-ink);
  }
  .tagline {
    margin: var(--space-2) 0 0;
    font-style: italic;
    font-size: var(--step-1);
    color: var(--color-ink-muted);
    max-width: none;
  }
  /* Scroll-driven parallax: the image drifts down at a fraction of scroll speed
     once the top of the scene reaches the top of the viewport. The gap it opens
     above stays offscreen, so the image needs no extra height and shows in full
     at rest. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .scene {
        view-timeline: --hero block;
      }
      .art {
        animation-name: drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(30%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (min-width: 48rem) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    .bar,
    .title {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .title,
    .scene {
      grid-row: 2;
      grid-column: 1;
    }
    .title {
      z-index: 1;
      align-self: start;
      padding-top: var(--space-3);
      padding-bottom: 0;
      text-align: right;
      text-shadow: var(--shadow-text);
    }
    h1 {
      font-size: var(--step-5-overlay);
    }
    .tagline {
      margin-top: var(--space-1);
      color: var(--color-ink);
    }
  }
</style>
