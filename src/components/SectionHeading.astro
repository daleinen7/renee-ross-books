---
interface Props {
  label: string;
  title: string;
  id?: string;
  level?: 2 | 3;
}
const { label, title, id, level = 2 } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

<div class="section-heading">
  <p class="label">{label}</p>
  <Tag id={id}>{title}</Tag>
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .label {
    margin: 0;
  }
</style>
